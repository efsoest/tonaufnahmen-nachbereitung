{
  "name": "fiery-galaxy",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "format:write": "prettier --write \"src/**/*.ts\"",
    "export": "bun build ./src/index.ts --compile --target=bun-windows-x64 --outfile=Tonaufnahmen-Nachbereitung.exe",
    "deploy": "./deploy.sh"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.3.0",
    "@types/yaml": "^1.9.7",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.3.0",
    "node-id3": "^0.2.9",
    "ora": "^9.3.0",
    "yaml": "^2.8.2"
  }
}